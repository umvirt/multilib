. config.sh
cd $SRCROOT
tar -xf binutils-2.45.tar.xz
cd binutils-2.45

mkdir -v build
cd       build

../configure --prefix=$LFS/tools \
             --with-sysroot=$LFS/tools \
             --target=$LFS_TGT   \
             --disable-nls       \
             --enable-gprofng=no \
             --disable-werror    \
             --enable-new-dtags  \
             --enable-default-hash-style=gnu \
             --with-lib-path=$LFS/tools/lib:$LFS/tools/lib32

make
make install

