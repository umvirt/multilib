. config.sh
cd $SRCROOT

rm -rf gcc-15.2.0


tar -xf gcc-15.2.0.tar.xz
cd gcc-15.2.0

sed -e '/m64=/s/lib64/lib/' \
    -i.orig gcc/config/i386/t-linux64

tar -xf ../mpfr-4.2.2.tar.xz
mv -v mpfr-4.2.2 mpfr
tar -xf ../gmp-6.3.0.tar.xz
mv -v gmp-6.3.0 gmp
tar -xf ../mpc-1.3.1.tar.gz
mv -v mpc-1.3.1 mpc

#sed -e '/m64=/s/lib64/lib/' \
#    -e '/m32=/s/m32=.*/m32=..\/lib32$(call if_multiarch,:i386-linux-gnu)/' \
#    -i.orig gcc/config/i386/t-linux64

#sed '/STACK_REALIGN_DEFAULT/s/0/(!TARGET_64BIT \&\& TARGET_SSE)/' \
#      -i gcc/config/i386/i386.h

mkdir -v build
cd       build

#forcing slibdir,localprefix
#    --with-slibdir=$LFS/lib     \
#    --with-local-prefix=$LFS
#    --enable-default-pie        \
#    --enable-default-ssp        \
#    --enable-initfini-array     \


mlist=m64,m32
../configure                    \
    --target=$LFS_TGT           \
    --prefix=$LFS/tools         \
    --with-slibdir=$LFS/tools/lib     \
    --with-glibc-version=2.42   \
    --with-sysroot=$LFS/tools         \
    --with-slibdir=$LFS/tools/lib     \
    --with-newlib               \
    --without-headers           \
    --disable-nls               \
    --disable-shared            \
    --enable-multilib           \
    --with-multilib-list=$mlist \
    --disable-decimal-float     \
    --disable-threads           \
    --disable-libatomic         \
    --disable-libgomp           \
    --disable-libquadmath       \
    --disable-libssp            \
    --disable-libvtv            \
    --disable-libstdcxx         \
    --enable-languages=c,c++

make
make install

