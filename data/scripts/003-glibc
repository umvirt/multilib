. config.sh
cd $SRCROOT

tar -xf glibc-2.43.tar.xz

cd glibc-2.43

#ln -sfv ../lib/ld-linux-x86-64.so.2 $LFS/tools/lib64
#ln -sfv ../lib/ld-linux-x86-64.so.2 $LFS/tools/lib64/ld-lsb-x86-64.so.3

patch -Np1 -i ../glibc-fhs-1.patch

mkdir -v build
cd       build

echo "rootsbindir=/usr/sbin" > configparms

#use system include directory for headers becuse they installed
#forcing binutils, multi-arch

CC="$LFS_TGT-gcc -m32"                   \
CXX="$LFS_TGT-g++ -m32"                  \
../configure                             \
      --prefix=/usr                      \
      --host=$LFS_TGT32                  \
      --build=$(../scripts/config.guess) \
      --disable-nscd                     \
      --with-headers=/usr/include        \
      --libdir=/usr/lib32                \
      --libexecdir=/usr/lib32            \
      libc_cv_slibdir=/usr/lib32         \
      --with-binutils=$LFS/tools/bin           \
      --enable-multi-arch                \
      --enable-kernel=5.4

make

#install files on system, not in $LFS
make DESTDIR=$PWD/DESTDIR install
cp -a DESTDIR/usr/lib32 /usr/

#reset files date for better detection
find DESTDIR/usr/include/ -exec touch -m {} +

install -vm644 DESTDIR/usr/include/gnu/{lib-names,stubs}-32.h \
               /usr/include/gnu/

ln -svf /usr/lib32/ld-linux.so.2 /lib/ld-linux.so.2
ln -svf /usr/lib32/ld-linux.so.2 /lib/ld-lsb.so.3
ln -svf /lib/locale /usr/lib32/locale
echo "/usr/lib32" >> /etc/ld.so.conf

